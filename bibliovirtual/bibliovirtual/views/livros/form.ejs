<% locals.activePage = 'livros'; %>
<%- include('../partials/header', { title: livro ? 'Editar Livro' : 'Novo Livro' }) %>

<main>
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/admin">Painel</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/admin/livros">Livros</a>
        <span class="breadcrumb-sep">›</span>
        <span><%= livro ? 'Editar' : 'Novo Livro' %></span>
      </div>
      <h1 style="margin-top:0.5rem;"><%= livro ? '✏️ Editar Livro' : '➕ Cadastrar Novo Livro' %></h1>
    </div>
  </div>

  <div class="container" style="padding-bottom: 3rem;">
    <% if (erro) { %>
      <div class="alert alert-danger">⚠️ <%= erro %></div>
    <% } %>

    <div class="card" style="max-width: 700px;">
      <div class="card-body">
        <form action="<%= livro ? '/admin/livros/' + livro.id : '/admin/livros' %>" method="POST">
          <div class="form-group">
            <label>Título *</label>
            <input type="text" name="titulo" class="form-control" placeholder="Título do livro" value="<%= livro ? livro.titulo : '' %>" required>
          </div>
          <div class="form-group">
            <label>Autor *</label>
            <input type="text" name="autor" class="form-control" placeholder="Nome do autor" value="<%= livro ? livro.autor : '' %>" required>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Categoria *</label>
              <input type="text" name="categoria" class="form-control" placeholder="Romance, Ficção, Tecnologia..." value="<%= livro ? livro.categoria : '' %>" required>
            </div>
            <div class="form-group">
              <label>Ano de Publicação</label>
              <input type="number" name="ano" class="form-control" placeholder="2024" value="<%= livro ? livro.ano : '' %>" min="1000" max="2099">
            </div>
          </div>
          <div class="form-group">
            <label>Sinopse</label>
            <textarea name="sinopse" class="form-control" placeholder="Descrição do livro..."><%= livro ? livro.sinopse : '' %></textarea>
          </div>
          <div class="d-flex gap-2" style="margin-top:0.5rem;">
            <button type="submit" class="btn btn-primary">💾 Salvar Livro</button>
            <a href="/admin/livros" class="btn btn-ghost">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
