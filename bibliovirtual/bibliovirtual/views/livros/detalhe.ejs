<% locals.activePage = 'acervo'; %>
<%- include('../partials/header', { title: livro.titulo }) %>

<main>
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/livros">Acervo</a>
        <span class="breadcrumb-sep">›</span>
        <span><%= livro.titulo %></span>
      </div>
    </div>
  </div>

  <div class="container" style="padding-bottom: 3rem;">
    <% if (locals.erro) { %>
      <div class="alert alert-danger">⚠️ <%= locals.erro %></div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <div class="book-detail">
          <div class="book-detail-cover">📖</div>
          <div class="book-detail-info">
            <h1><%= livro.titulo %></h1>
            <p class="book-meta"><strong><%= livro.autor %></strong> &bull; <%= livro.categoria %> &bull; <%= livro.ano %></p>
            <span class="badge <%= livro.disponivel ? 'badge-available' : 'badge-unavailable' %>" style="font-size:0.82rem;">
              <%= livro.disponivel ? '✅ Disponível para empréstimo' : '❌ Indisponível — já emprestado' %>
            </span>
            <p class="book-sinopse"><%= livro.sinopse || 'Sem sinopse cadastrada.' %></p>

            <div class="d-flex gap-2" style="flex-wrap:wrap;">
              <% if (usuario) { %>
                <% if (livro.disponivel) { %>
                  <form action="/emprestimos" method="POST">
                    <input type="hidden" name="livroId" value="<%= livro.id %>">
                    <button type="submit" class="btn btn-success">📚 Emprestar este livro</button>
                  </form>
                <% } else { %>
                  <button class="btn btn-ghost" disabled>📚 Indisponível</button>
                <% } %>
              <% } else { %>
                <a href="/auth/login" class="btn btn-primary">🔐 Faça login para emprestar</a>
              <% } %>
              <a href="/livros" class="btn btn-outline">← Voltar ao acervo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
