<%- include('../partials/header', { title: 'Acesso Negado' }) %>

<main class="error-page error-403">
  <div>
    <div class="error-code">403</div>
    <div class="error-title">Acesso Negado</div>
    <p class="error-desc">Você não tem permissão para acessar esta página. Esta área é restrita para administradores.</p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">← Voltar para o Início</a>
      <% if (usuario) { %>
        <a href="/emprestimos/meus" class="btn btn-outline">Meus Empréstimos</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline">Fazer Login</a>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
